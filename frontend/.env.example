// Frontend .env.example

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Note: Update this to match the port your frontend is running on (default: 3000, but may be 3001 if 3000 is in use)
VITE_GOOGLE_CALLBACK_URL=http://localhost:3001/auth-callback
