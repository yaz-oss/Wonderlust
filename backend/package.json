{
  "name": "wonderlust-backend",
  "version": "1.0.0",
  "description": "Wonderlust API backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:dev && tsx watch src/index.ts",
    "build": "tsc",
    "start": "npm run db:init && node dist/index.js",
    "db:init": "prisma generate && prisma migrate deploy && npm run db:seed",
    "db:dev": "prisma migrate deploy && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
    ,"lint": "eslint \"src/**/*.{ts,tsx}\" --fix"
    ,"test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@prisma/client": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.40.0",
    "openai": "^4.24.0",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/express-session": "^1.17.10",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.3.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.54.0",
    "prisma": "^5.6.0"
  }
}
